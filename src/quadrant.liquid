<div class="layout">
  <img
    class="image image-dither image--contain"
    src="{{ data.img }}"
    alt="{{ data.title | default: 'Comic' }}"
    style="width:100%;height:100%;"
    />
</div>

<div class="title_bar">
  <span class="title">  {% if data.feed == "heyokyay" %}heyokyay
    {% elsif data.feed == "islieb" %}islieb
    {% elsif data.feed == "isfies" %}isfies
    {% else %}Feed
    {% endif %}</span>
  <span class="instance">

    {{ data.title }}
  </span>
</div>
